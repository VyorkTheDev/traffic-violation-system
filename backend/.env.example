# ── Güvenlik ──────────────────────────────────────────────────────────────────
# Üretimde güçlü, rastgele bir değer kullanın (ör: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-strong-random-secret

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_DEBUG=false

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Cloud DB kullanıyorsanız DATABASE_URL satırını açın, diğerlerini kapatın.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traffic_db

# ── Anthropic (Claude API) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# AI modeli ve maksimum yeniden deneme sayısı
AI_MODEL=claude-sonnet-4-6
AI_MAX_RETRIES=2

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Dosya yükleme ─────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
# MAX_CONTENT_LENGTH=16777216   # 16 MB (varsayılan)

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Geliştirme: memory:// (varsayılan), Production: redis://localhost:6379/0
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# ── E-posta (Brevo HTTP API) ──────────────────────────────────────────────────
# Brevo'da doğrulanmış gönderici e-postası (Senders & Domains)
MAIL_USERNAME=your-verified-sender@example.com
# Brevo dashboard → Settings → API Keys
BREVO_API_KEY=xkeysib-...

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
